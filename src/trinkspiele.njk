        {% for g in glossary %}
        { "@type": "DefinedTerm", "@id": "{{ site.url }}{{ page.url }}#glossar-{{ g.slug }}", "name": {{ g.term | dump | safe }}, "description": {{ g.def | dump | safe }}, "inDefinedTermSet": "{{ site.url }}{{ page.url }}#glossar" }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "ItemList",
      "name": "Trinkspiele-Übersicht",
      "itemListElement": [
        {% for game in collections.games %}
        {%- set gm = gameMeta[game.fileSlug] %}
        { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ game.data.name | dump | safe }}, "url": "{{ site.url }}{{ game.url }}", "image": "{% if gm and gm.image %}{{ site.url }}{{ gm.image }}{% else %}{{ site.ogImage }}{% endif %}" }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Trinkspiele", "item": "{{ site.url }}{{ page.url }}" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {% for f in faqs %}
        { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  ]
}
</script>
