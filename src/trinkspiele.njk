<div class="games-hub">
  <div class="games-hub__header">
    <div class="container">
      <nav class="crumb" aria-label="Brotkrumen-Navigation"><a href="{{ '/' | url }}">Start</a> <span aria-hidden="true">&rsaquo;</span> <span class="crumb__current">Trinkspiele</span></nav>
      <span class="eyebrow">Trinkspiele &amp; Partyspiele</span>
      <h1 class="games-hub__title">Trinkspiele.<br>Regeln &amp; Anleitungen.</h1>
      <p class="games-hub__lede">Die besten <strong>Trinkspiele</strong> für jede Party — mit klaren Regeln, Equipment-Liste und Tipps. Lustige Spiele für die große Gruppe, Klassiker mit Würfeln und Karten, Spiele ganz ohne Zubehör: Filtere nach Spieleranzahl, Intensität und Art, bis das passende dabei ist.</p>
      <p class="games-hub__byline">Von der <a href="{{ '/redaktion/' | url }}"><strong>Dare Pong</strong> Redaktion</a>{% if updated %} · zuletzt geprüft am <time datetime="{{ updated | dateISO }}">{{ updated | dateDE }}</time>{% endif %}</p>
      {% set st = collections.games | gamesStats %}
