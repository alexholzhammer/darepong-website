<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0E0E10">

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ ogImage or site.ogImage }}">
  <meta property="og:locale" content="{{ site.locale }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.twitterHandle }}">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ ogImage or site.ogImage }}">

  <!-- Structured Data -->
  {% if jsonLdType == "product" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Product",
        "name": "{{ site.product.name }}",
        "description": "{{ site.product.description }}",
        "sku": "{{ site.product.sku }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ site.product.brand }}"
        },
        "image": "{{ site.ogImage }}",
        "offers": {
          "@type": "Offer",
          "price": "{{ site.product.price }}",
          "priceCurrency": "{{ site.product.currency }}",
          "availability": "{{ site.product.availability }}",
          "url": "{{ site.product.amazonUrl }}",
          "seller": {
            "@type": "Organization",
            "name": "{{ site.product.brand }}"
          }
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in faq %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.a | dump | safe }}
            }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      },
      {
        "@type": "WebSite",
        "url": "{{ site.url }}",
        "name": "{{ site.name }}"
      }
    ]
  }
  </script>
  {% elif jsonLdType == "article" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": {{ title | dump | safe }},
        "description": {{ (description or summary) | dump | safe }},
        "datePublished": "{{ date | dateISO }}",
        "dateModified": "{{ date | dateISO }}",
        "image": "{{ ogImage or site.ogImage }}",
        "url": "{{ site.url }}{{ page.url }}",
        "publisher": {
          "@type": "Organization",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}"
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "{{ site.url }}{{ page.url }}"
        }
      }{% if faq %},
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in faq %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.a | dump | safe }}
            }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }{% endif %}
    ]
  }
  </script>
  {% endif %}

  <!-- Google Tag Manager — deferred to keep the main thread free during first
       paint. Loads on the first user interaction, or shortly after load for
       passive visitors so the Cookiebot consent banner still appears. -->
  <script>(function(w,d,s,l,i){
    w[l]=w[l]||[];
    var loaded=false;
    function load(){
      if(loaded)return;loaded=true;
      w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),
          dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
    }
    var evts=['scroll','keydown','mousemove','touchstart','click'];
    function trigger(){evts.forEach(function(e){w.removeEventListener(e,trigger);});load();}
    evts.forEach(function(e){w.addEventListener(e,trigger,{passive:true});});
    w.addEventListener('load',function(){setTimeout(load,2500);});
  })(window,document,'script','dataLayer','GTM-KXSBKFDX');</script>
  <!-- End Google Tag Manager -->

  <!-- Google Fonts — async to avoid render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Graduate&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Graduate&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap"></noscript>

  <!-- Critical styles inlined to remove the render-blocking CSS requests -->
  <style>{{ "global.css" | inlineCSS | safe }}</style>
  {% if pageCSS %}
  <style>{{ pageCSS | inlineCSS | safe }}</style>
  {% endif %}
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KXSBKFDX"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <header class="site-header">
    <div class="site-header__inner">
      <a href="{{ '/' | url }}" class="site-header__brand">Dare Pong</a>
      <button class="site-header__toggle" aria-label="Menu" onclick="document.querySelector('.site-header__nav').classList.toggle('is-open')">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-header__nav">
        <a href="{{ '/#how' | url }}">So geht's</a>
        <a href="{{ '/#dares' | url }}">Dares</a>
        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown__toggle" aria-haspopup="true" aria-expanded="false" aria-controls="nav-partyspiele">
            Partyspiele
            <svg class="nav-dropdown__caret" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-dropdown__menu" id="nav-partyspiele">
            <a href="{{ '/partyspiele/' | url }}" class="nav-dropdown__all">Alle Partyspiele &rarr;</a>
            {% for game in collections.games %}
            <a href="{{ game.url | url }}">{{ game.data.name }}</a>
            {% endfor %}
          </div>
        </div>
        <a href="https://amzn.to/4nA0xYQ">Kaufen</a>
        <a href="{{ '/blog' | url }}">Blog</a>
        <a href="{{ '/#faq' | url }}">FAQ</a>
      </nav>
      <a href="https://amzn.to/4nA0xYQ" class="site-header__cta" target="_blank" rel="noopener">
        <span>Auf Amazon kaufen</span>
        <span class="site-header__cta-dot">&#8594;</span>
      </a>
    </div>
  </header>

  <main id="main">
  {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__brand-col">
        <span class="site-footer__brand">Dare Pong</span>
        <span class="site-footer__tagline">Raus aus der Komfortzone!</span>
        <span class="site-footer__legal">&copy; 2026 Spielleute GmbH &middot; Bremen, Deutschland</span>
      </div>
      <div class="site-footer__cols">
        <div class="site-footer__col">
          <span class="site-footer__col-head">Spiel</span>
          <a href="{{ '/#how' | url }}">So geht's</a>
          <a href="{{ '/#dares' | url }}">Dares</a>
          <a href="{{ '/partyspiele/' | url }}">Partyspiele</a>
          <a href="https://amzn.to/4nA0xYQ">Kaufen</a>
        </div>
        <div class="site-footer__col">
          <span class="site-footer__col-head">Hilfe</span>
          <a href="{{ '/#faq' | url }}">FAQ</a>
          <a href="#">Versand</a>
          <a href="{{ '/kontakt/' | url }}">Kontakt</a>
        </div>
        <div class="site-footer__col">
          <span class="site-footer__col-head">Folgen</span>
          <a href="#">Instagram</a>
          <a href="#">Facebook</a>
          <a href="#">TikTok</a>
        </div>
        <div class="site-footer__col">
          <span class="site-footer__col-head">Blog</span>
          <a href="{{ '/blog' | url }}">Alle Artikel</a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <div class="site-footer__bottom-links">
        <a href="{{ '/impressum/' | url }}">Impressum</a>
        <a href="{{ '/datenschutz/' | url }}">Datenschutz</a>
      </div>
    </div>
  </footer>

  <script src="{{ '/js/global.js' | url }}" defer></script>
  {% if pageJS %}
  <script src="{{ ('/js/' + pageJS) | url }}" defer></script>
  {% endif %}

</body>
</html>
