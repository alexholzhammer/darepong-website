<!DOCTYPE html>
{# Game pages set `name` (not `title`); fall back to it so the <title> is never empty #}
{% set pageTitle = title or name %}
{# Per-game social preview image: /assets/og/<slug>.jpg (generated). Falls back site-wide. #}
{% set pageOgImage = ogImage %}
{% if not pageOgImage and tags and ("game" in tags) %}{% set pageOgImage = site.url + "/assets/og/" + page.fileSlug + ".jpg" %}{% endif %}
{% set pageOgImage = pageOgImage or site.ogImage %}
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-F8H1RYRV4K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-F8H1RYRV4K');
  </script>

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url | encodeUrl }}">

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0E0E10">

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url | encodeUrl }}">
  <meta property="og:image" content="{{ pageOgImage }}">
  <meta property="og:locale" content="{{ site.locale }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.twitterHandle }}">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ pageOgImage }}">

  <!-- Site-wide entity: Organization + WebSite (helps brand entity / E-E-A-T) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ site.logo }}"
        },
        "sameAs": [
          "https://www.instagram.com/darepong/",
          "https://www.facebook.com/DarePongOfficial/"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": "{{ site.name }}",
        "inLanguage": "de-DE",
        "publisher": { "@id": "{{ site.url }}/#organization" }
      }
    ]
  }
  </script>

  <!-- Structured Data -->
  {% if jsonLdType == "product" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Product",
        "name": "{{ site.product.name }}",
        "description": "{{ site.product.description }}",
        "sku": "{{ site.product.sku }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ site.product.brand }}"
        },
        "image": "{{ site.ogImage }}",
        "offers": {
          "@type": "Offer",
          "price": "{{ site.product.price }}",
          "priceCurrency": "{{ site.product.currency }}",
          "availability": "{{ site.product.availability }}",
          "url": "{{ site.product.amazonUrl }}",
          "seller": {
            "@type": "Organization",
            "name": "{{ site.product.brand }}"
          }
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in productFaq %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.a | dump | safe }}
            }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
    ]
  }
  </script>
  {% elif jsonLdType == "article" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": {{ title | dump | safe }},
        "description": {{ (description or summary) | dump | safe }},
        "datePublished": "{{ date | dateISO }}",
        "dateModified": "{{ date | dateISO }}",
        "image": "{{ ogImage or site.ogImage }}",
        "url": "{{ site.url }}{{ page.url | encodeUrl }}",
        "publisher": {
          "@type": "Organization",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}"
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "{{ site.url }}{{ page.url | encodeUrl }}"
        }
      }{% if faq %},
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in faq %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.a | dump | safe }}
            }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }{% endif %}
    ]
  }
  </script>
  {% endif %}

  <!-- Google Tag Manager — deferred to keep the main thread free during first
       paint. Loads on the first user interaction, or shortly after load for
       passive visitors so the Cookiebot consent banner still appears. -->
  <script>(function(w,d,s,l,i){
    w[l]=w[l]||[];
    var loaded=false;
    function load(){
      if(loaded)return;loaded=true;
      w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),
          dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
    }
    var evts=['scroll','keydown','mousemove','touchstart','click'];
    function trigger(){evts.forEach(function(e){w.removeEventListener(e,trigger);});load();}
    evts.forEach(function(e){w.addEventListener(e,trigger,{passive:true});});
    w.addEventListener('load',function(){setTimeout(load,2500);});
  })(window,document,'script','dataLayer','GTM-KXSBKFDX');</script>
  <!-- End Google Tag Manager -->

  <!-- Google Fonts — async to avoid render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Graduate&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Graduate&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap"></noscript>

  <!-- Critical styles inlined to remove the render-blocking CSS requests -->
  <style>{{ "global.css" | inlineCSS | safe }}</style>
  {% if pageCSS %}
  <style>{{ pageCSS | inlineCSS | safe }}</style>
  {% endif %}
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KXSBKFDX"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <header class="site-header">
