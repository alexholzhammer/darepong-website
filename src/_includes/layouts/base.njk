            <a href="{{ '/kings-cup/' | url }}">King&rsquo;s Cup</a>
            <a href="{{ '/flunkyball/' | url }}">Flunkyball</a>
            <a href="{{ '/rage-cage/' | url }}">Rage Cage</a>
            <a href="{{ '/maexchen/' | url }}">Mäxchen</a>
          </div>
        </div>
        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown__toggle" aria-haspopup="true" aria-expanded="false" aria-controls="nav-ratgeber">
            Ratgeber
            <svg class="nav-dropdown__caret" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-dropdown__menu" id="nav-ratgeber">
            <a href="{{ '/blog/' | url }}" class="nav-dropdown__all">Alle Artikel &rarr;</a>
            <span class="nav-dropdown__head">Geschenke</span>
            <a href="{{ '/geschenke/' | url }}">Geschenke-Übersicht</a>
            <a href="{{ '/post/trinkspiel-geschenk/' | url }}">Trinkspiel als Geschenk</a>
            <a href="{{ '/post/wichtelgeschenk-unter-10-euro/' | url }}">Wichtelgeschenk unter 10 €</a>
            <a href="{{ '/post/jga-geschenk/' | url }}">JGA-Geschenk</a>
          </div>
        </div>
        <a href="{{ '/#how' | url }}">So geht's</a>
        <a href="{{ '/#faq' | url }}">FAQ</a>
      </nav>
      <a href="https://amzn.to/4nA0xYQ" class="site-header__cta" target="_blank" rel="noopener">
        <span>Auf Amazon kaufen</span>
        <span class="site-header__cta-dot">&#8594;</span>
      </a>
    </div>
  </header>

  <main id="main">
  {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__brand-col">
        <span class="site-footer__brand">Dare Pong</span>
        <span class="site-footer__tagline">Raus aus der Komfortzone!</span>
        <span class="site-footer__legal">&copy; 2026 Spielleute GmbH &middot; Bremen, Deutschland</span>
      </div>
      <div class="site-footer__cols">
        <div class="site-footer__col">
          <span class="site-footer__col-head">Spiel</span>
          <a href="{{ '/#how' | url }}">So geht's</a>
          <a href="{{ '/#dares' | url }}">Dares</a>
          <a href="https://amzn.to/4nA0xYQ">Kaufen</a>
        </div>
        <div class="site-footer__col">
          <span class="site-footer__col-head">Trinkspiele</span>
          <a href="{{ '/trinkspiele/' | url }}">Alle Trinkspiele</a>
          <a href="{{ '/partyspiele/' | url }}">Partyspiele</a>
          <a href="{{ '/trinkspiele/draussen/' | url }}">Für draußen</a>
          <a href="{{ '/trinkspiele/gruppe/' | url }}">Große Gruppen</a>
          <a href="{{ '/trinkspiele/ohne-zubehoer/' | url }}">Ohne Zubehör</a>
        </div>
        <div class="site-footer__col">
          <span class="site-footer__col-head">Hilfe</span>
          <a href="{{ '/#faq' | url }}">FAQ</a>
          <a href="{{ '/redaktion/' | url }}">Redaktion</a>
          <a href="{{ '/kontakt/' | url }}">Kontakt</a>
        </div>
        <div class="site-footer__col">
          <span class="site-footer__col-head">Folgen</span>
          <a href="https://www.instagram.com/darepong/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.facebook.com/DarePongOfficial/" target="_blank" rel="noopener">Facebook</a>
        </div>
        <div class="site-footer__col">
          <span class="site-footer__col-head">Ratgeber</span>
          <a href="{{ '/blog/' | url }}">Blog</a>
          <a href="{{ '/geschenke/' | url }}">Geschenke</a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <div class="site-footer__bottom-links">
        <a href="{{ '/impressum/' | url }}">Impressum</a>
        <a href="{{ '/datenschutz/' | url }}">Datenschutz</a>
      </div>
    </div>
  </footer>

  <script src="{{ '/js/global.js' | url }}" defer></script>
  {% if pageJS %}
  <script src="{{ ('/js/' + pageJS) | url }}" defer></script>
  {% endif %}

</body>
</html>
