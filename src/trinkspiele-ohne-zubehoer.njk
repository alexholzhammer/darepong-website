          <tr><th scope="row"><a href="{{ '/wasserfall/' | url }}">Wasserfall</a></th><td>3+</td><td>Alle trinken gleichzeitig; absetzen darf erst, wer links von sich aufhören sieht.</td></tr>
        </tbody>
      </table>
